# Copy to .env for local docker-compose use. Defaults below need zero API keys.
ENVIRONMENT=local
LOG_LEVEL=INFO
GIT_SHA=dev

# app <-> compose services
DATABASE_URL=postgresql://tollgate:tollgate@postgres:5432/tollgate
REDIS_URL=redis://redis:6379/0

# llm/ provider selection - "mock" needs no keys and is what CI/compose use by default
LLM_PROVIDER=mock
LLM_MAX_RETRY_ATTEMPTS=5

# Gateway behaviour (all optional; see README Runbook table)
# Comma-separated fallback order; empty means the price-ordered free-tier default.
TOLLGATE_CHAIN=
SKIP_MARGIN=0.1
# Bearer key required on every gateway route when set. Leave empty for local dev:
# the edge stays open and startup says so once, loudly.
EDGE_API_KEY=
# Cache. An empty salt generates a per-process secret; entries then do not
# survive restarts, and the log says so.
CACHE_SALT=
CACHE_TTL_S=3600
# Semantic layer stays off until both are set. Threshold is deliberately not
# defaulted: BACKLOG M6 measures what a threshold costs before one ships.
SEMANTIC_THRESHOLD=
EMBEDDING_BACKEND=none
EMBEDDING_MODEL_DIR=models/all-MiniLM-L6-v2
METERING_PATH=metering.jsonl

# Real provider keys (only needed if you set LLM_PROVIDER to one of these)
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_API_KEY=
SARVAM_API_KEY=

# OpenTelemetry - leave blank to disable exporting entirely (no-op)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
