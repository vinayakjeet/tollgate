# Copy to .env for local docker-compose use. Defaults below need zero API keys.
ENVIRONMENT=local
LOG_LEVEL=INFO
GIT_SHA=dev

# app <-> compose services
DATABASE_URL=postgresql://tollgate:tollgate@postgres:5432/tollgate
REDIS_URL=redis://redis:6379/0

# llm/ provider selection - "mock" needs no keys and is what CI/compose use by default
LLM_PROVIDER=mock
LLM_MAX_RETRY_ATTEMPTS=5

# Real provider keys (only needed if you set LLM_PROVIDER to one of these)
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_API_KEY=
SARVAM_API_KEY=

# OpenTelemetry - leave blank to disable exporting entirely (no-op)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
